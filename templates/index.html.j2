{% extends "_layout.html.j2" %}
{% block content %}

<section class="filters" aria-label="Filters">
  {% if grouped_tag_counts %}
    {% for group_label, group_filter, group_tags in grouped_tag_counts %}
    <div class="filter-group">
      <strong>{{ group_label }}</strong>
      <button class="chip active" data-filter="{{ group_filter }}" data-value="">All</button>
      {% for tag, count in group_tags %}
      <button class="chip" data-filter="{{ group_filter }}" data-value="{{ tag }}">{{ tag }} <span class="count">{{ count }}</span></button>
      {% endfor %}
    </div>
    {% endfor %}
  {% else %}
    <div class="filter-group">
      <strong>Tag</strong>
      <button class="chip active" data-filter="tag" data-value="">All</button>
      {% for tag, count in top_tags %}
      <button class="chip" data-filter="tag" data-value="{{ tag }}">{{ tag }} <span class="count">{{ count }}</span></button>
      {% endfor %}
    </div>
  {% endif %}
  <div class="filter-group">
    <strong>Source</strong>
    <button class="chip active" data-filter="source" data-value="">All</button>
    <button class="chip" data-filter="source" data-value="arxiv">arXiv</button>
    <button class="chip" data-filter="source" data-value="github">GitHub</button>
    <button class="chip" data-filter="source" data-value="news">News</button>
  </div>
  <div class="filter-group">
    <strong>Priority</strong>
    <button class="chip active" data-filter="priority" data-value="">All</button>
    <button class="chip" data-filter="priority" data-value="must_read">High</button>
    <button class="chip" data-filter="priority" data-value="save_for_later">Mid</button>
    <button class="chip" data-filter="priority" data-value="low_priority">Low</button>
  </div>
  <div class="filter-group">
    <strong>Time</strong>
    <button class="chip active" data-filter="time" data-value="">All</button>
    <button class="chip" data-filter="time" data-value="7">1 week</button>
    <button class="chip" data-filter="time" data-value="31">1 month</button>
    <button class="chip" data-filter="time" data-value="93">3 months</button>
  </div>
</section>

{% if archive_days %}
<section class="archive-nav" aria-label="Daily archive">
  <strong>Daily archive:</strong>
  {% for d in archive_days[:14] %}
  <a href="daily/{{ d }}.html">{{ d }}</a>
  {% endfor %}
  {% if archive_days|length > 14 %}<span class="muted">… {{ archive_days|length - 14 }} earlier</span>{% endif %}
</section>
{% endif %}

<p class="result-count"><span id="visible-count">{{ (items_with_code|length) + (items_news|length) + (items_papers_only|length) }}</span> of {{ (items_with_code|length) + (items_news|length) + (items_papers_only|length) }} items</p>

<section class="section" id="section-code">
  <h2 class="section-title">Code &amp; repos <span class="muted">(<span class="section-count" data-section="code">{{ items_with_code|length }}</span>)</span></h2>
  <p class="section-hint muted">GitHub repositories and papers that release code or a project page. The actionable stuff.</p>
  <div class="items">
    {% for it in items_with_code %}
      {% include "_item.html.j2" %}
    {% else %}
      <p class="muted">No code-bearing items in this batch.</p>
    {% endfor %}
  </div>
</section>

<section class="section" id="section-news">
  <h2 class="section-title">News &amp; articles <span class="muted">(<span class="section-count" data-section="news">{{ items_news|length }}</span>)</span></h2>
  <p class="section-hint muted">Industry pulse — company announcements, funding, demos, journalism. Updated daily.</p>
  <div class="items">
    {% for it in items_news %}
      {% include "_item.html.j2" %}
    {% else %}
      <p class="muted">No news items in this batch.</p>
    {% endfor %}
  </div>
</section>

<section class="section section-deprioritized" id="section-papers-only">
  <h2 class="section-title">Papers only <span class="muted">(<span class="section-count" data-section="papers">{{ items_papers_only|length }}</span>)</span></h2>
  <p class="section-hint muted">No code or project page detected. Lower priority — but kept here for completeness.</p>
  <div class="items">
    {% for it in items_papers_only %}
      {% include "_item.html.j2" %}
    {% else %}
      <p class="muted">No papers-only items in this batch.</p>
    {% endfor %}
  </div>
</section>

<script src="{{ url_root }}filters.js"></script>
{% endblock %}
