<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}{{ site.title }}{% endblock %}</title>
<meta name="description" content="{{ site.description }}">
<link rel="stylesheet" href="{{ url_root }}styles.css?v={{ generated_ts }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ url_root }}feed.xml">
</head>
<body>
<header class="site-header">
  <h1><a href="{{ url_root }}index.html">{{ site.title }}</a></h1>
  <p class="tagline">{{ site.description }}</p>
  <p class="updated">Updated every morning, 07:00–09:00 KST · last build {{ generated }}</p>
</header>
<main>
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
  <p>Sources: arXiv · GitHub &nbsp;·&nbsp; <a href="{{ url_root }}feed.xml">RSS feed</a></p>
  <p class="muted">Generated by <code>rnews</code>. Not affiliated with any source.</p>
</footer>
</body>
</html>
