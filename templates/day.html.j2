{% extends "_layout.html.j2" %}
{% block title %}{{ date }} — {{ site.title }}{% endblock %}
{% block content %}

<section class="archive-nav">
  <a href="../index.html">&larr; Latest</a>
  {% if prev_day %}<a href="{{ prev_day }}.html">&larr; {{ prev_day }}</a>{% endif %}
  {% if next_day %}<a href="{{ next_day }}.html">{{ next_day }} &rarr;</a>{% endif %}
</section>

<h2>Daily snapshot — {{ date }}</h2>
<p class="muted">{{ items|length }} item{{ '' if items|length == 1 else 's' }} first seen on this date, sorted by relevance score.</p>

<section class="items">
  {% for it in items %}
    {% include "_item.html.j2" %}
  {% endfor %}
</section>
{% endblock %}
