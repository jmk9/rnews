{% extends "_layout.html.j2" %}
{% block title %}{{ date }} — {{ site.title }}{% endblock %}
{% block content %}

<section class="archive-nav">
  <a href="../index.html">&larr; Latest</a>
  {% if prev_day %}<a href="{{ prev_day }}.html">&larr; {{ prev_day }}</a>{% endif %}
  {% if next_day %}<a href="{{ next_day }}.html">{{ next_day }} &rarr;</a>{% endif %}
</section>

<h2>Daily snapshot — {{ date }}</h2>
<p class="muted">{{ items|length }} item{{ '' if items|length == 1 else 's' }} first seen on this date.</p>

<section class="section">
  <h3 class="section-title">Code &amp; repos <span class="muted">(<span class="section-count" data-section="code">{{ items_with_code|length }}</span>)</span></h3>
  <div class="items">
    {% for it in items_with_code %}
      {% include "_item.html.j2" %}
    {% else %}
      <p class="muted">No code-bearing items.</p>
    {% endfor %}
  </div>
</section>

<section class="section">
  <h3 class="section-title">News &amp; articles <span class="muted">(<span class="section-count" data-section="news">{{ items_news|length }}</span>)</span></h3>
  <div class="items">
    {% for it in items_news %}
      {% include "_item.html.j2" %}
    {% else %}
      <p class="muted">No news items.</p>
    {% endfor %}
  </div>
</section>

<section class="section section-deprioritized">
  <h3 class="section-title">Papers only <span class="muted">(<span class="section-count" data-section="papers">{{ items_papers_only|length }}</span>)</span></h3>
  <div class="items">
    {% for it in items_papers_only %}
      {% include "_item.html.j2" %}
    {% else %}
      <p class="muted">No papers-only items.</p>
    {% endfor %}
  </div>
</section>
{% endblock %}
