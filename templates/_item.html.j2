<article class="item"
  data-source="{{ it.source }}"
  data-priority="{{ it.priority }}"
  data-tags="{{ (it.tags or []) | join(' ') }}"
  data-published="{{ (it.updated or it.published or '')[:10] }}"
  data-created="{{ (it.published or it.updated or '')[:10] }}"
  data-stars="{{ (it.extra.stars if it.extra and it.extra.stars is defined else 0) }}"
  data-score="{{ it.score or 0 }}">

  {# Thumbnail: prefer the real "main figure" we extracted —
       - arxiv: local PNG of figure 1 from the PDF -> extra.thumbnail_path
       - github: first image in the rendered README     -> extra.thumbnail
       - news:   RSS media image or og:image            -> extra.thumbnail
     Otherwise a small source-colored placeholder so the layout stays uniform.
     loading="lazy" defers the 1500-card image load until scroll. #}
  {% set thumb_path = it.extra.thumbnail_path if it.extra else none %}
  {% set thumb_url = it.extra.thumbnail if it.extra else none %}
  {% if thumb_path or thumb_url %}
    {# data-source lets filters.js swap a broken image for a placeholder
       instead of leaving a blank gap (onerror used to just hide it). #}
    <img class="item-thumb" data-source="{{ it.source }}"
         src="{{ (url_root ~ thumb_path) if thumb_path else thumb_url }}"
         loading="lazy" alt="" />
  {% else %}
    <div class="item-thumb item-thumb-placeholder item-thumb-{{ it.source }}">
      <span>{{ it.source }}</span>
    </div>
  {% endif %}

  <div class="item-body">
    <div class="item-header">
      <a class="item-title" href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}</a>
      <span class="badge badge-{{ it.source }}">{{ it.source }}</span>
      {% if it.priority %}<span class="badge badge-{{ it.priority }}">{{ priority_label(it.priority) }}</span>{% endif %}
      {% if it.extra and it.extra.is_new %}<span class="badge badge-new">NEW</span>{% endif %}
    </div>
    <div class="item-meta">
      {% if it.authors %}
        {{ it.authors[:5] | join(', ') }}{% if it.authors|length > 5 %} et al.{% endif %} ·
      {% endif %}
      {% if it.source == 'github' and it.extra and it.extra.stars is defined %}
        ★ {{ it.extra.stars }} ·
        {% if it.extra.language %}{{ it.extra.language }} · {% endif %}
      {% endif %}
      {% set created = (it.published or '')[:10] %}
      {% set active = (it.updated or '')[:10] %}
      {% if it.source == 'github' %}
        {% if created %}Created {{ created }}{% endif %}{% if created and active and active != created %} · Active {{ active }}{% endif %}
      {% elif it.source == 'news' %}
        {% if active or created %}Published {{ active or created }}{% endif %}
      {% else %}
        {% if created %}Submitted {{ created }}{% endif %}{% if created and active and active[:10] != created[:10] %} · Updated {{ active }}{% endif %}
      {% endif %}
    </div>
    {% if it.tags %}
    <div class="item-tags">
      {% for t in it.tags %}<span class="tag">{{ t }}</span>{% endfor %}
    </div>
    {% endif %}
    {% if it.summary %}
    <p class="item-summary">{{ it.summary }}</p>
    {% endif %}
  </div>
</article>
